# Copy to /etc/imbegnal-runner.env (systemd) or runner/deploy/.env (docker compose) and chmod 600.
# install.sh generates this file for you, with a random secret.

# REQUIRED. HMAC key shared with the Worker (`wrangler secret put RUNNER_SECRET`), at least 32
# characters. Generate with:  openssl rand -hex 32
RUNNER_SECRET=

# Bind address / port. Keep 127.0.0.1 and put a TLS tunnel or reverse proxy in front (see README).
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4242

# Toolchain image the job containers are created from (runner/Dockerfile).
RUNNER_IMAGE=imbegnal-runner:full

# Containers running at once, and jobs allowed to wait for a slot (beyond that: 503 busy).
# Plan roughly 1 CPU core and 0.5-1 GiB RAM per concurrent job (see README, capacity planning).
RUNNER_MAX_CONCURRENCY=4
RUNNER_QUEUE_MAX=16
RUNNER_QUEUE_TIMEOUT_MS=30000

# Optional OCI runtime for job containers, e.g. runsc (gVisor). Empty = Docker's default (runc).
RUNNER_DOCKER_RUNTIME=

# Optional: pull the image at start-up when it is missing (needs a registry-hosted image).
RUNNER_PREPULL=0

# Optional: restrict the offered languages (comma separated ids); empty = all that pass the smoke test.
RUNNER_LANGS=

# debug | info | warn | error. Logs never contain code, stdin or program output at any level.
RUNNER_LOG_LEVEL=info

# --- docker compose only ---
# Group id of the docker socket on the host:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Host port published on 127.0.0.1 for the runner.
RUNNER_PUBLISH_PORT=4242
# `--profile tunnel`: token of a remotely managed Cloudflare Tunnel whose public hostname points at http://runner:4242
CLOUDFLARE_TUNNEL_TOKEN=
# `--profile caddy`: public DNS name Caddy obtains a certificate for.
RUNNER_DOMAIN=
