# syntax=docker/dockerfile:1
#
# The runner SERVICE as a container (docker-compose.yml). This is not the toolchain image that
# jobs run in (that is runner/Dockerfile). Build context is the repository root:
#
#   docker build -f runner/deploy/Dockerfile.service -t imbegnal-runner-service .
#
# The service needs the docker CLI and access to a Docker socket: see the trade-off notes in
# docker-compose.yml and runner/README.md.
ARG NODE_IMAGE=mirror.gcr.io/library/node:22-slim
ARG DOCKER_CLI_IMAGE=mirror.gcr.io/library/docker:27-cli

FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM ${NODE_IMAGE} AS build
WORKDIR /src
# The compiler lives outside the source tree so the repository needs no node_modules.
RUN npm install --prefix /tool --no-audit --no-fund --ignore-scripts typescript@5.9.3 @types/node@22
COPY runner/tsconfig.json runner/tsconfig.json
COPY runner/src runner/src
COPY shared/protocol.ts shared/languages.ts shared/
RUN /tool/node_modules/.bin/tsc -p runner --typeRoots /tool/node_modules/@types --outDir /out

FROM ${NODE_IMAGE}
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=build /out /app
RUN useradd --system --uid 10001 --create-home --home-dir /home/runner --shell /usr/sbin/nologin runner
USER runner
ENV NODE_ENV=production \
    HOME=/home/runner \
    RUNNER_HOST=0.0.0.0 \
    RUNNER_PORT=4242
EXPOSE 4242
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.RUNNER_PORT||4242)+'/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "/app/runner/src/main.js"]
