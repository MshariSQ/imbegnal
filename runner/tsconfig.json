{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../shared/protocol.ts", "../shared/languages.ts"],
  "exclude": ["dist", "node_modules"]
}
